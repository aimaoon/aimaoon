# ── Google OAuth（Google Cloud Console で取得。README の手順を参照）──────────
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# アプリのURL。ローカルならこのままでOK
APP_URL=http://localhost:3000

# ── セッション暗号化キー ────────────────────────────────────────────────
# 下のコマンドで生成した値を貼り付けてください:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── データベース（SQLite。触らなくてOK）─────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── 初回同期の取り込み範囲 ──────────────────────────────────────────────
# 何日前までのメールを読み込むか。0 にすると全期間
SYNC_DAYS_BACK=180
# 1回の同期で取り込む最大メール数の上限
SYNC_MAX_MESSAGES=2000

# ── デモモード ────────────────────────────────────────────────────────
# 1 にすると、Google 連携なしでサンプルデータを触れる「サンプルデータで試す」
# ボタンがログイン画面に出ます。本番で使うときは削除してください。
DEMO_MODE=0

# ── 未返信の緊急度 ────────────────────────────────────────────────────
# 顧客の最後のメールから何時間で段階を上げるか。運用に合わせて変更してください。
# 実時間で計算します。土日も交代で対応する運用のため、
# 週末や営業時間外もそのまま経過時間に含めます。
URGENCY_WATCH_HOURS=4      # これを過ぎたら「要対応」
URGENCY_LATE_HOURS=24      # これを過ぎたら「遅延」
URGENCY_CRITICAL_HOURS=48  # これを過ぎたら「重大な遅れ」
