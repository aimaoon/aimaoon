# Cloudflare Pages のキャッシュ指示。
# version.json と入口の HTML は毎回確かめさせる。ここが握られると更新に気づけない。
/version.json
  Cache-Control: no-cache, must-revalidate
  Content-Type: application/json; charset=utf-8

/index.html
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# 中身が変わればファイル名も変わるので、こちらは長く持たせてよい。
/assets/*
  Cache-Control: public, max-age=31536000, immutable
