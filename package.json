{
  "name": "mailtickets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push",
    "demo": "node scripts/setup-demo.mjs",
    "seed:demo": "esbuild scripts/seed-demo.ts --bundle --platform=node --format=cjs --outfile=.test-build/seed.cjs --external:@prisma/client --log-level=error && node .test-build/seed.cjs",
    "test:unit": "esbuild tests/unit.mts --bundle --platform=node --format=cjs --outfile=.test-build/unit.cjs --external:@prisma/client --log-level=error && node .test-build/unit.cjs",
    "test:api": "node tests/api.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "googleapis": "^173.0.0",
    "jose": "^5.9.6",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.14.0"
  },
  "overrides": {
    "google-auth-library": "^10.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/sanitize-html": "^2.13.0",
    "esbuild": "^0.28.1",
    "prisma": "^6.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  }
}
